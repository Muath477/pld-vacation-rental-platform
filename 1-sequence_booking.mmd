sequenceDiagram
    participant Guest
    participant Property

    Guest->>Property: is_available(start_date, end_date)
    Property-->>Guest: true
    create participant Booking
    Guest->>Booking: create_booking(property, start_date, end_date)
    create participant Payment
    Booking->>Payment: process_payment()
    Payment-->>Booking: payment confirmed
    Booking->>Booking: confirm_booking()
    Booking-->>Guest: booking confirmed
